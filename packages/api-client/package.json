  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@agent-network/api": "workspace:*",
    "@agent-network/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "eslint": "^9.18.0",
    "react": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
