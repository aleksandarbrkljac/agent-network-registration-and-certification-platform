{
  "name": "agent-network",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Network Registration & Certification Platform — golden-path-shaped, local-runnable.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@agent-network/api --filter=@agent-network/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:push": "pnpm --filter @agent-network/db db:push",
    "db:seed": "pnpm --filter @agent-network/db db:seed",
    "db:reset": "pnpm --filter @agent-network/db db:reset",
    "setup": "pnpm --filter @agent-network/db db:push && pnpm --filter @agent-network/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
